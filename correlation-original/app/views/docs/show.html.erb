<% content_for :title, "#{@page.humanize} - Documentation" %>

<div class="doc-page">
  <div class="doc-nav">
    <%= link_to documentation_path, class: "back-link" do %>
      ← Back to Documentation
    <% end %>
  </div>

  <div class="doc-content">
    <div class="markdown-content">
      <%= render_markdown(@content) %>
    </div>
  </div>
</div>

<style>
.doc-page {
  padding: 0;
}

.doc-nav {
  background: var(--bg-secondary, #2a2d3a);
  border-bottom: 1px solid var(--border-color, #3a3d4a);
  padding: 1rem 1.5rem;
}

.back-link {
  color: #667eea;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s ease;
}

.back-link:hover {
  color: #764ba2;
}

.doc-content {
  max-width: 1000px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
}

.markdown-content {
  color: var(--text-primary, #ffffff);
  line-height: 1.7;
}

.markdown-content h1 {
  color: var(--text-primary, #ffffff);
  font-size: 2.25rem;
  font-weight: 600;
  margin: 0 0 1.5rem 0;
  border-bottom: 2px solid #667eea;
  padding-bottom: 0.75rem;
}

.markdown-content h2 {
  color: var(--text-primary, #ffffff);
  font-size: 1.75rem;
  font-weight: 600;
  margin: 2.5rem 0 1rem 0;
  border-bottom: 1px solid var(--border-color, #3a3d4a);
  padding-bottom: 0.5rem;
}

.markdown-content h3 {
  color: var(--text-primary, #ffffff);
  font-size: 1.375rem;
  font-weight: 600;
  margin: 2rem 0 0.75rem 0;
}

.markdown-content p {
  color: var(--text-secondary, #94a3b8);
  margin: 0 0 1.25rem 0;
}

.markdown-content a {
  color: #667eea;
  text-decoration: none;
}

.markdown-content a:hover {
  color: #764ba2;
  text-decoration: underline;
}

.markdown-content code {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 0.25rem;
  padding: 0.125rem 0.375rem;
  font-family: 'Monaco', 'Consolas', monospace;
  font-size: 0.875rem;
  color: #a855f7;
}

.markdown-content pre {
  background: #1e1e2e;
  border: 1px solid var(--border-color, #3a3d4a);
  border-radius: 0.5rem;
  padding: 1rem;
  overflow-x: auto;
  margin: 1rem 0;
}

.markdown-content pre code {
  background: none;
  border: none;
  padding: 0;
  color: #f8f8f2;
}

.markdown-content ul, .markdown-content ol {
  color: var(--text-secondary, #94a3b8);
  margin: 0 0 1.25rem 0;
  padding-left: 1.5rem;
}

.markdown-content li {
  margin-bottom: 0.5rem;
}

.markdown-content blockquote {
  background: rgba(102, 126, 234, 0.1);
  border-left: 4px solid #667eea;
  padding: 1rem 1.5rem;
  margin: 1.5rem 0;
  border-radius: 0 0.5rem 0.5rem 0;
}

.markdown-content blockquote p {
  margin: 0;
  color: var(--text-primary, #ffffff);
}

.markdown-content table {
  width: 100%;
  border-collapse: collapse;
  margin: 1.5rem 0;
  background: var(--bg-secondary, #2a2d3a);
  border-radius: 0.5rem;
  overflow: hidden;
}

.markdown-content th,
.markdown-content td {
  padding: 0.75rem 1rem;
  text-align: left;
  border-bottom: 1px solid var(--border-color, #3a3d4a);
}

.markdown-content th {
  background: rgba(102, 126, 234, 0.1);
  color: var(--text-primary, #ffffff);
  font-weight: 600;
}

.markdown-content td {
  color: var(--text-secondary, #94a3b8);
}

@media (max-width: 768px) {
  .doc-content {
    padding: 1rem;
  }
  
  .markdown-content h1 {
    font-size: 1.875rem;
  }
  
  .markdown-content h2 {
    font-size: 1.5rem;
  }
  
  .markdown-content pre {
    font-size: 0.8rem;
  }
  
  .markdown-content table {
    font-size: 0.875rem;
  }
}
</style>