<% content_for :title, "Documentation - Stock Correlation Analysis Platform" %>

<div class="docs-content">
  <header class="docs-header">
    <div class="container">
      <h1>📚 Documentation</h1>
      <p>Comprehensive guides and technical references for the Stock Correlation Analysis Platform</p>
    </div>
  </header>

  <main class="container">
    <div class="docs-grid">
      <% @docs.each do |doc| %>
        <div class="doc-card">
          <div class="doc-icon">
            <%= doc[:icon] %>
          </div>
          <h3><%= doc[:title] %></h3>
          <p><%= doc[:description] %></p>
          <%= link_to documentation_page_path(doc[:slug]), class: "doc-link" do %>
            Read Documentation →
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="quick-links">
      <h2>Quick Access</h2>
      <div class="link-grid">
        <a href="<%= documentation_page_path('api-reference') %>" class="quick-link">
          <span class="link-icon">🚀</span>
          <span>Get Started with API</span>
        </a>
        <a href="<%= documentation_page_path('analysis-method') %>" class="quick-link">
          <span class="link-icon">🧮</span>
          <span>Understand the Math</span>
        </a>
        <a href="<%= visualizations_path %>" class="quick-link">
          <span class="link-icon">📊</span>
          <span>View Visualizations</span>
        </a>
        <a href="<%= documentation_page_path('rake-tasks') %>" class="quick-link">
          <span class="link-icon">⚙️</span>
          <span>Run Analysis Tasks</span>
        </a>
      </div>
    </div>
  </main>
</div>

<style>
.docs-content {
  padding: 0;
}

.docs-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 3rem 0;
  margin-bottom: 2rem;
}

.docs-header h1 {
  font-size: 2.5rem;
  margin: 0 0 0.5rem 0;
  font-weight: 600;
}

.docs-header p {
  font-size: 1.125rem;
  opacity: 0.9;
  margin: 0;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.docs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 1.5rem;
  margin-bottom: 3rem;
}

.doc-card {
  background: var(--bg-secondary, #2a2d3a);
  border-radius: 0.75rem;
  padding: 1.5rem;
  border: 1px solid var(--border-color, #3a3d4a);
  transition: all 0.2s ease;
}

.doc-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
  border-color: #667eea;
}

.doc-icon {
  font-size: 2rem;
  margin-bottom: 1rem;
}

.doc-card h3 {
  color: var(--text-primary, #ffffff);
  font-size: 1.25rem;
  font-weight: 600;
  margin: 0 0 0.75rem 0;
}

.doc-card p {
  color: var(--text-secondary, #94a3b8);
  line-height: 1.6;
  margin: 0 0 1.25rem 0;
}

.doc-link {
  display: inline-flex;
  align-items: center;
  color: #667eea;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s ease;
}

.doc-link:hover {
  color: #764ba2;
}

.quick-links {
  background: var(--bg-secondary, #2a2d3a);
  border-radius: 0.75rem;
  padding: 2rem;
  border: 1px solid var(--border-color, #3a3d4a);
}

.quick-links h2 {
  color: var(--text-primary, #ffffff);
  font-size: 1.5rem;
  font-weight: 600;
  margin: 0 0 1.5rem 0;
}

.link-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
}

.quick-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 0.5rem;
  color: var(--text-primary, #ffffff);
  text-decoration: none;
  transition: all 0.2s ease;
}

.quick-link:hover {
  background: rgba(102, 126, 234, 0.1);
  border-color: #667eea;
  transform: translateY(-1px);
}

.link-icon {
  font-size: 1.25rem;
}

.quick-link span:last-child {
  font-weight: 500;
}

@media (max-width: 768px) {
  .docs-header {
    padding: 2rem 0;
  }
  
  .docs-header h1 {
    font-size: 2rem;
  }
  
  .docs-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  
  .quick-links {
    padding: 1.5rem;
  }
  
  .link-grid {
    grid-template-columns: 1fr;
  }
}
</style>